<group name="macos,syslog,">
    <!-- Critical System Events -->
    <rule id="600001" level="12">
        <if_group>syslog</if_group>
        <match>kernel</match>
        <regex type="pcre2">panic|kernel trap|fatal|critical</regex>
        <description>macOS: Critical kernel panic or fatal error detected</description>
        <group>system_error</group>
    </rule>
    
    <!-- Noise reduction for Critical System Events -->
    <rule id="600002" level="0">
        <if_sid>600001</if_sid>
        <regex type="pcre2">critical (?:section|path|region)|thermal|temperature|cooling|USB.*disconnect|device.*removed|hardware.*disconnect</regex>
        <description>macOS: Noise reduction for kernel messages (thermal, hardware disconnects, etc.)</description>
    </rule>
    
    <!-- System Integrity Protection (SIP) Violations -->
    <rule id="600005" level="12">
        <if_group>syslog</if_group>
        <match>kernel</match>
        <regex type="pcre2">System Integrity Protection|SIP violation</regex>
        <description>macOS: System Integrity Protection violation detected</description>
        <group>system_error</group>
    </rule>
    
    <!-- Noise reduction for SIP -->
    <rule id="600006" level="0">
        <if_sid>600005</if_sid>
        <regex type="pcre2">SIP (?:status|enabled|disabled|configuration)|checking SIP|Xcode|lldb|dtrace|dtruss|developer|Software Update|system update|macOS update|installer|recovery mode|recovery boot|csrutil</regex>
        <description>macOS: SIP status check, developer tools, or system update - noise reduction</description>
    </rule>
    
    <rule id="600009" level="8">
        <if_sid>600005</if_sid>
        <regex type="pcre2">SIP (?:warning|notice)|may be restricted</regex>
        <description>macOS: SIP warning or notice (not violation)</description>
        <group>system_error,pci_dss_10.6.1,gpg13_4.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.7,tsc_CC7.1</group>
    </rule>
    
    <!-- Keychain Access with Noise Reduction -->
    <rule id="600011" level="8">
        <if_group>syslog</if_group>
        <match>SecurityAgent</match>
        <regex type="pcre2">keychain|password</regex>
        <description>macOS: Keychain access detected</description>
        <group>access_control,pci_dss_10.2.1,gpg13_7.8,gdpr_IV_32.2,hipaa_164.312.a.2.I,nist_800_53_AC.2,tsc_CC6.1</group>
    </rule>
    
    <!-- Noise reduction for Keychain Access -->
    <rule id="600012" level="0">
        <if_sid>600011</if_sid>
        <regex type="pcre2">keychain.*(?:unlock|repair|verify|first.*aid|create)|normal.*access|automatic.*unlock|login.*keychain|Safari|Mail|Calendar|Contacts|System Preferences|loginwindow|autofill|auto-fill|password.*suggestion|iCloud.*keychain|new.*keychain|keychain.*setup</regex>
        <description>macOS: Normal keychain operations (unlock, system apps, autofill, etc.) - noise reduction</description>
    </rule>
    
    <rule id="600015" level="12">
        <if_sid>600011</if_sid>
        <regex type="pcre2">keychain.*(?:export|dump)|password.*extract|unauthorized.*access</regex>
        <description>macOS: Suspicious keychain export or unauthorized access</description>
        <group>access_control,credential_theft,pci_dss_10.2.1,gpg13_7.8,gdpr_IV_32.2,hipaa_164.312.a.2.I,nist_800_53_AC.2,tsc_CC6.1</group>
    </rule>
    
    <rule id="600018" level="0">
        <if_sid>600011</if_sid>
        <time>00:00-06:00</time>
        <regex type="pcre2">backup|sync|maintenance</regex>
        <description>macOS: Scheduled keychain maintenance operations - noise reduction</description>
    </rule>
    
    <!-- Gatekeeper Bypass with Noise Reduction -->
    <rule id="600019" level="10">
        <if_group>syslog</if_group>
        <match>Gatekeeper</match>
        <regex type="pcre2">bypass|disabled|override</regex>
        <description>macOS: Gatekeeper security bypass detected</description>
        <group>system_error,pci_dss_10.6.1,gpg13_4.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.3,tsc_CC7.1</group>
    </rule>
    
    <!-- Noise reduction for Gatekeeper -->
    <rule id="600020" level="0">
        <if_sid>600019</if_sid>
        <regex type="pcre2">System Preferences|spctl.*--master-disable|administrator.*disabled|developer.*mode|Xcode|development.*certificate|codesign.*override|Software Update|macOS.*installer|Apple.*installer|system.*update|temporary.*override|one.*time.*bypass|user.*approved|MDM|Jamf|SCCM|enterprise.*policy|corporate.*override</regex>
        <description>macOS: Legitimate Gatekeeper changes (admin, developer, system update, MDM) - noise reduction</description>
    </rule>
    
    <rule id="600023" level="12">
        <if_sid>600019</if_sid>
